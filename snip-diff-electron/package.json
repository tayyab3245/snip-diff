{
  "name": "snip-diff-electron",
  "version": "1.0.0",
  "description": "Electron frontend for SNIP-DIFF file comparison tool",
  "main": "dist/main/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:backend": "cd ../snip-diff-api && python app/main.py",
    "dev:renderer": "vite",
    "dev:main": "delay 8s && electron .",
    "dev:frontend-only": "concurrently \"npm run dev:renderer\" \"npm run dev:main-no-wait\"",
    "dev:main-no-wait": "tsc -p src/main && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "tsc && vite build",
    "build:main": "tsc -p src/main",
    "preview": "vite preview",
    "electron": "electron .",
    "pack": "electron-builder",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "diff",
    "code-analysis",
    "snip-diff"
  ],
  "author": "Tayyab",
  "license": "Proprietary",
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "delay-cli": "^2.0.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "framer-motion": "^10.16.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.tayyab.snip-diff",
    "productName": "SNIP-DIFF",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
